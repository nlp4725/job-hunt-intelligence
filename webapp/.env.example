# Written by CI from the Terraform outputs; copy to .env.local for `npm run dev`.
VITE_API_BASE=https://api.joblygo.com
VITE_COGNITO_DOMAIN=jhi-joblygo.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=3oi49qmis33vo7dgurv2ar480r
# Needed by our own sign-in pages: the Cognito library talks to the pool directly.
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# Which federated providers the pool actually has, as a comma-separated list
# ("google,apple"). Empty means the social buttons are not drawn at all.
VITE_SOCIAL_PROVIDERS=
